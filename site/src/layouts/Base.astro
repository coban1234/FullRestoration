---
import "../styles/global.css";
import { Header } from "../components/layout/Header";
import { MobileActionBar } from "../components/layout/MobileActionBar";
import Footer from "../components/layout/Footer.astro";
import Breadcrumbs, { type Crumb } from "../components/layout/Breadcrumbs.astro";
import { company, office, phone } from "../data/site";

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  noindex?: boolean;
  hideActionBar?: boolean;
  hideBarWhileVisible?: string[];
  schema?: Record<string, unknown>[];
}

const { title, description, crumbs = [], noindex = false, hideActionBar = false, hideBarWhileVisible = [], schema = [] } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = site + Astro.url.pathname;

const org = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": `${site}/#org`,
  name: company.name,
  legalName: company.legalName,
  url: `${site}/`,
  telephone: phone.e164,
  email: company.email,
  address: { "@type": "PostalAddress", streetAddress: office.line1, addressLocality: office.city, addressRegion: office.region, postalCode: office.postal, addressCountry: "CA" },
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "07:30", closes: "17:00" }],
  areaServed: ["Vancouver", "North Vancouver", "West Vancouver", "Burnaby", "Richmond", "New Westminster", "Coquitlam", "Surrey", "Langley", "Abbotsford", "Chilliwack"].map((n) => ({ "@type": "City", name: n })),
};
const breadcrumbSchema = crumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.label, item: c.href ? site + c.href : canonical })),
    }
  : null;
const graph = [org, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta name="theme-color" content="#F4F1EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body class="min-h-screen bg-plaster font-sans text-char">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:bg-char focus:px-4 focus:py-3 focus:text-plaster">Skip to main content</a>
    <Header client:load current={current} />
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <main id="main" class:list={["has-bar", { "no-bar": hideActionBar }]}>
      <slot />
    </main>
    <Footer />
    {!hideActionBar && <MobileActionBar client:idle hideWhileVisible={hideBarWhileVisible} />}
  </body>
</html>
