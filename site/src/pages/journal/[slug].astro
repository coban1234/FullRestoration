---
import Base from "../../layouts/Base.astro";
import CTABand from "../../components/ui/CTABand.astro";
import PhotoSlot from "../../components/ui/PhotoSlot.astro";
import { publishedArticles, type Article } from "../../data/journal";
import { team } from "../../data/site";
import { articleSchema, siteUrl } from "../../lib/schema";

export function getStaticPaths() {
  return publishedArticles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Article };
const site = siteUrl(Astro.site);
const author = team.find((t) => t.name === a.author);
const heroLabel: Record<string, string> = {
  "kitchen-renovation-cost-vancouver-2026": "Burnaby kitchen at handover",
  "how-to-read-a-renovation-quote": "Fixed-price proposal on the kitchen table",
  "legal-secondary-suites-compared": "Surrey suite after — same position",
  "change-order-vs-overrun": "Burnaby split-level, rough-in, open studs and new wiring",
  "inside-the-walls-1960s-vancouver-house": "1960s split-level taken back to studs, demo",
  "fixed-price-vs-cost-plus": "Fixed-price contract on the kitchen table",
  "where-to-live-during-whole-home-renovation": "Moving day, packed boxes in the hall",
  "bathroom-waterproofing": "Shower membrane, seams banded, before the flood test",
  "permit-timelines-compared": "Permit card posted at the front window",
  "twelve-questions-before-you-sign": "WorkSafeBC clearance letter dated this month",
  "bc-unregulated-renovation-market": "BC Registry search for the company name",
  "renovations-that-pay-back": "Street view, renovated house on a tree-lined street",
};
const words = a.body!.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length;
---
<Base title={`${a.title} | Stonecroft`} description={a.excerpt} crumbs={[{ label: "Home", href: "/" }, { label: "Journal", href: "/journal/" }, { label: a.title.length > 48 ? a.title.slice(0, 46) + "…" : a.title }]} schema={[articleSchema(site, { headline: a.title, path: `/journal/${a.slug}/`, datePublished: a.published!, dateModified: a.modified, author: a.author, description: a.excerpt })]}>
  <article>
    <header class="ruled border-b border-line">
      <div class="container-x max-w-[900px] py-10 md:py-14">
        <p class="eyebrow">Journal · {String(a.n).padStart(2, "0")}</p>
        <h1 class="mt-5 font-display text-[32px] font-semibold leading-[1.08] tracking-[-0.01em] md:text-[48px]">{a.title}</h1>
        <p class="mt-5 text-[15px] text-slate">By <span class="font-medium text-char">{a.author}</span>{author && `, ${author.role.toLowerCase()}`} · <time class="font-mono" datetime={a.published}>{a.published}</time> · <span class="font-mono">{Math.max(1, Math.round(words / 230))} min</span></p>
      </div>
    </header>
    <div class="container-x max-w-[900px] py-10 md:py-14">
      <PhotoSlot ratio="aspect-[16/9]" label={heroLabel[a.slug] ?? "Kitchen at handover"} class="mb-10" />
      <div class="prose-sc" set:html={a.body} />
      {a.related && (
        <aside class="mt-12 border-t border-char pt-5">
          <h2 class="text-[14px] font-medium text-slate">Related</h2>
          <ul class="mt-3 flex flex-wrap gap-3">{a.related.map((r) => <li><a href={r.href} class="btn-secondary">{r.label}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>
  <CTABand />
</Base>
