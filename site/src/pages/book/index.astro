---
import Base from "../../layouts/Base.astro";
import PhotoSlot from "../../components/ui/PhotoSlot.astro";
import { BookFull } from "../../components/booking/BookFull";
import { phone } from "../../data/site";

const steps = [
  ["We call within one business day.", "From the person who would run your job."],
  ["We visit for 60–90 minutes, usually within two to three weeks.", "We look, measure and ask questions. Nothing is opened."],
  ["You get a fixed-price proposal in five to ten business days.", "Yours to keep, sign, or take elsewhere."],
];
const title = "Book a Site Visit — Renovation Quote, Vancouver | Stonecroft";
const description = "Request a site visit for a renovation in Vancouver or the Fraser Valley. We call within one business day; a fixed-price proposal follows in 5–10 days.";
---
<Base title={title} description={description} crumbs={[{ label: "Home", href: "/" }, { label: "Book a site visit" }]} hideActionBar>
  <section class="bg-concrete py-8 md:py-12">
    <div class="container-x grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h1 class="font-display text-[32px] font-semibold leading-[1.05] md:text-[44px]">Book a site visit</h1>
        <p class="mt-3 max-w-[50ch] text-[17px] text-slate">No charge. A fixed scope and price follows, whether you hire us or not.</p>
        <div class="mt-6">
          <BookFull client:load />
        </div>
        <noscript><p class="mt-4 text-[16px]">This form needs JavaScript to send. Call <a href={phone.href} class="font-mono underline">{phone.display}</a> or email <a href="mailto:hello@stonecroft.ca" class="underline">hello@stonecroft.ca</a>.</p></noscript>
      </div>
      <aside class="lg:col-span-5 lg:pt-[108px]">
        <h2 class="border-b border-char pb-2 text-[14px] font-medium text-slate">What happens next</h2>
        <ol class="mt-5 space-y-6">
          {steps.map(([h, t], i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-char font-mono text-[13px]">{i + 1}</span>
              <div><p class="font-display text-[19px] font-medium leading-snug">{h}</p><p class="mt-1 text-[15px] text-slate">{t}</p></div>
            </li>
          ))}
        </ol>
        <p class="mt-8 border-t border-line pt-5 text-[16px]">Rather talk? <a href={phone.href} class="font-mono font-medium underline underline-offset-4">{phone.display}</a>, weekdays <span class="font-mono">07:30–17:00</span>.</p>
        <p class="mt-2 text-[15px] text-slate">No obligation, no deposit, no pressure to decide on the day.</p>
        <PhotoSlot class="mt-8" ratio="aspect-[3/2]" label="Crew arriving at a house, van in the driveway" />
      </aside>
    </div>
  </section>
</Base>
