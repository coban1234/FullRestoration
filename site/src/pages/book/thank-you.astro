---
import Base from "../../layouts/Base.astro";
import { phone } from "../../data/site";
---
<Base title="Request Received — Stonecroft" description="Your site visit request has been received." noindex hideActionBar>
  <section class="ruled py-14 md:py-20">
    <div class="container-x max-w-[820px]">
      <p class="flex items-center gap-2 font-mono text-[13px] text-green-dk">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="#4A7C59" /></svg>
        Request received <span id="ty-ref"></span>
      </p>
      <h1 class="h1 mt-5" id="ty-title">Thank you. We have your request.</h1>
      <p class="lede mt-4 text-slate" id="ty-lede">We will call you within one business day to book the visit.</p>
      <ol class="mt-10 space-y-5 border-t border-char pt-6">
        {[
          ["Within one business day", "A call from the person who would run your job, to book a time."],
          ["Within two to three weeks", "A 60–90 minute site visit. We look, measure, and ask a lot of questions. No charge."],
          ["Five to ten business days later", "A fixed-price proposal with every line, allowance and exclusion written down."],
        ].map(([h, t], i) => (
          <li class="grid gap-1 md:grid-cols-[48px_260px_1fr]">
            <span class="font-mono text-[13px] text-slate">{String(i + 1).padStart(2, "0")}</span>
            <span class="font-display text-[19px] font-medium">{h}</span>
            <span class="text-[16px] text-slate">{t}</span>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-[16px]">Something urgent? Call <a href={phone.href} class="font-mono font-medium underline underline-offset-4">{phone.display}</a>.</p>
      <h2 class="mt-12 font-display text-[22px] font-medium">While you wait</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {[["/build-log/", "This week's build log", "Including the job running late"], ["/pricing/", "What it costs here", "Every published range"], ["/projects/", "Finished projects", "Final cost against signed"]].map(([h, l, s]) => (
          <li><a href={h} class="chamfer block h-full border border-line bg-white p-5 hover:border-char"><span class="font-display text-[18px] font-medium">{l}</span><span class="mt-1 block text-[14px] text-slate">{s}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<script>
  try {
    const lead = JSON.parse(sessionStorage.getItem("sc-lead") || "null");
    if (lead) {
      const first = String(lead.name || "").split(" ")[0];
      if (first) document.getElementById("ty-title")!.textContent = `Thank you, ${first}. We have your request.`;
      if (lead.phone) document.getElementById("ty-lede")!.textContent = `We will call ${lead.phone} within one business day to book a visit${lead.municipality ? ` in ${lead.municipality}` : ""}.`;
      if (lead.ref) document.getElementById("ty-ref")!.textContent = `· ${lead.ref}`;
    }
    (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: "booking_complete" });
  } catch {
    /* ignore */
  }
</script>
