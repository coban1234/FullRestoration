---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import CTABand from "../components/ui/CTABand.astro";
import PhotoSlot from "../components/ui/PhotoSlot.astro";
import { promiseHeading, promises, team } from "../data/site";

const title = "About Stonecroft — A Renovation Firm That Publishes Its Logs | Stonecroft";
const description = "Who Stonecroft is, why we publish a weekly log of every job, the crew who turn up at your house, and what we do not do.";
---
<Base title={title} description={description} crumbs={[{ label: "Home", href: "/" }, { label: "About" }]}>
  <PageHero eyebrow="About" title="A renovation firm that writes everything down" primary={null} secondary={null} />

  <Section id="why" num="01" tab="Why" title="Why we publish the logs">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="prose-sc lg:col-span-7">
        <p>I started publishing the logs after a client showed me the quote she had been given before ours. It was one page and one number. When the job went over, nobody could tell her why, or whose decision it had been. She was not angry about the money. She was angry that she had been asked to trust someone who never showed her anything.</p>
        <p>Renovation in BC is largely unregulated. Anyone can call themselves a contractor. The only defence a homeowner has is evidence — and the only way I know to give it is to write down what happened every week, including the weeks I would rather not, and let anyone read it.</p>
        <p>It has cost us some jobs. People who want the lowest number go elsewhere. The ones who stay read the log on Friday nights and call us when something worries them, which is exactly what I want.</p>
        <p class="font-display text-[19px]">— Daniel Okafor, owner</p>
      </div>
      <PhotoSlot class="lg:col-span-5" ratio="aspect-[4/5]" label="Daniel on site in Burnaby, reviewing the week's log on a phone" />
    </div>
  </Section>

  <Section id="crew" num="02" tab="Crew" title="The crew" tone="concrete" note="Photographed on site, not in a studio.">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {team.map((t) => (
        <li class="chamfer border border-line bg-white">
          <div class="photo-slot flex aspect-[4/5] items-center justify-center border-b border-line p-3 text-center" role="img" aria-label={`Photograph to come: ${t.name} on site`}><span class="font-mono text-[11px] uppercase tracking-[0.12em] text-slate">Photo slot<br /><span class="normal-case tracking-normal text-char">{t.name}, on site</span></span></div>
          <div class="p-4">
            <h3 class="font-display text-[19px] font-medium">{t.name}</h3>
            <p class="mt-1 text-[14px] leading-snug text-slate">{t.role}</p>
            <p class="mt-3 font-mono text-[12px] text-char">{t.years} years in the trade</p>
            <p class="mt-1 font-mono text-[11px] text-slate">{t.cert}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="structure" num="03" tab="Structure" title="How the firm is built">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="border-t border-char pt-4"><p class="font-mono text-[44px] leading-none">4</p><p class="mt-3 text-[16px]">projects on site at once, at most. That is a capacity claim, and it means your site lead is not running eight jobs.</p></div>
      <div class="border-t border-char pt-4"><p class="font-display text-[22px] font-medium">In-house</p><p class="mt-3 text-[16px] text-slate">Demolition, framing, carpentry, drywall, tile, finishing carpentry, project management.</p></div>
      <div class="border-t border-char pt-4"><p class="font-display text-[22px] font-medium">Subcontracted, and named</p><p class="mt-3 text-[16px] text-slate">Electrical, plumbing, gas, HVAC, abatement, countertops, glass. Every subtrade is named on your schedule, with their licence number, before you sign.</p></div>
    </div>
  </Section>

  <Section id="not" num="04" tab="We don't" title="What we do not do" tone="concrete">
    <ul class="grid gap-px border border-line bg-line md:grid-cols-2">
      {[
        ["Jobs under $20,000", "A specialist trade will serve you better and cost less. We will give you a name."],
        ["Work without permits", "Not for anyone, at any price."],
        ["Building-envelope remediation", "Leaky-condo and envelope-failure work starts with an envelope engineer. We will bid the scope their report produces."],
        ["Glass and sealed-unit repair", "A different trade. We replace windows only as part of a renovation."],
        ["New-build houses", "We renovate and add to existing buildings. For a new house, talk to a home builder registered with BC Housing."],
      ].map(([h, t]) => <li class="bg-white p-6"><h3 class="font-display text-[20px] font-medium">{h}</h3><p class="mt-2 text-[15px] text-slate">{t}</p></li>)}
    </ul>
  </Section>

  <Section id="promise" num="05" tab="Promise" title={promiseHeading} tone="dark">
    <ol class="grid gap-px border border-slate bg-slate md:grid-cols-4">
      {promises.map((p, i) => <li class="bg-char p-6"><span class="font-mono text-[12px] text-mist">{String(i + 1).padStart(2, "0")} · {p.key}</span><p class="mt-4 font-display text-[21px] font-medium leading-snug text-plaster">{p.text}</p></li>)}
    </ol>
  </Section>

  <CTABand />
</Base>
