---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Section from "../../components/ui/Section.astro";
import RangeTable from "../../components/ui/RangeTable.astro";
import CTABand from "../../components/ui/CTABand.astro";
import { StatusMark } from "../../components/StatusMark";
import { componentRanges, draws, excluded, factors, included, interiorRanges, notFor } from "../../data/pricing";
import { getProject, money } from "../../data/projects";
import { serviceSchema, siteUrl } from "../../lib/schema";

const site = siteUrl(Astro.site);
const finals = ["1968-burnaby-split-level-kitchen", "1991-langley-townhouse-bathrooms", "1979-surrey-rancher-legal-suite"].map(getProject);
const title = "Renovation Cost Vancouver & Fraser Valley — Published Prices | Stonecroft";
const description = "What renovation actually costs in Vancouver and the Fraser Valley: kitchens, bathrooms, whole-home per square foot, basements. Plus three real final invoices.";
---
<Base title={title} description={description} crumbs={[{ label: "Home", href: "/" }, { label: "Pricing" }]} schema={[serviceSchema(site, "Renovation", description, "/pricing/", { low: 20000, high: 500000 })]}>
  <PageHero eyebrow="Pricing" title="What renovation costs in Vancouver and the Fraser Valley" lede="Published ranges. No “contact us for pricing.”" />

  <Section id="ranges" num="01" tab="Ranges" title="The ranges" note="These are the ranges we actually contract at in this market. Your range depends on scope, finish and what the building is hiding.">
    <RangeTable rows={interiorRanges} caption="Interior renovation cost ranges" pushes="layout changes, structural work, a pre-1980 house that needs its services replaced, and condo or strata access rules." />
    <h3 class="h3 mt-14">Components, published so the main numbers are checkable</h3>
    <div class="mt-5"><RangeTable rows={componentRanges} caption="Component cost ranges" head={["Item", "Range", "Note"]} /></div>
  </Section>

  <Section id="factors" num="02" tab="Factors" title="What moves the number" tone="concrete">
    <ol class="grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {factors.map((f, i) => (
        <li class="bg-white p-5">
          <span class="font-mono text-[12px] text-slate">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-2 font-display text-[19px] font-medium leading-tight">{f.title}</h3>
          <p class="mt-1 font-mono text-[15px] text-clay-dk">{f.impact}</p>
          <p class="mt-2 text-[14px] leading-relaxed text-slate">{f.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="in-out" num="03" tab="In / out" title="What is and is not in a Stonecroft price">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="chamfer border border-line bg-white p-6">
        <h3 class="flex items-center gap-2 font-display text-[22px] font-medium"><StatusMark status="on-schedule" label="In" /> Included</h3>
        <ul class="mt-4 divide-y divide-line text-[16px]">{included.map((x) => <li class="py-2.5">{x}</li>)}</ul>
      </div>
      <div class="chamfer border border-line bg-white p-6">
        <h3 class="flex items-center gap-2 font-display text-[22px] font-medium"><StatusMark status="behind" label="Out" /> Not included</h3>
        <ul class="mt-4 divide-y divide-line text-[16px]">{excluded.map((x) => <li class="py-2.5">{x}</li>)}</ul>
        <p class="mt-4 border-l-2 border-clay pl-3 text-[15px]">Client-supplied materials come with no warranty from Stonecroft. We will install them; we cannot stand behind them.</p>
      </div>
    </div>
  </Section>

  <Section id="contingency" num="04" tab="Contingency" title="Contingency, and why ours is a line item" tone="concrete">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="prose-sc lg:col-span-7">
        <p>Every Stonecroft price carries a contingency, <strong>shown as its own line and included in the total</strong>: 8% as standard, 12% for buildings built before 1980, 15% where the scope includes structural changes.</p>
        <p>Most estimates either bury contingency in the line items or leave it out so the headline number looks smaller. Leaving it out is how a homeowner ends up over budget on a job that was priced correctly. Knob-and-tube wiring, asbestos in levelling compound and galvanised supply lines are all common in pre-1980 houses, and all are found after demolition.</p>
        <p>Contingency is drawn down only by signed change orders for conditions we could not see. Whatever is unspent comes back to you on the final invoice — on our <a href="/projects/1991-langley-townhouse-bathrooms/">Langley townhouse</a> job, that was a credit.</p>
      </div>
      <div class="chamfer border border-char bg-white p-6 font-mono text-[15px] lg:col-span-5">
        <p class="font-sans text-[13px] text-slate">Example — medium kitchen, pre-1980</p>
        <dl class="mt-3 divide-y divide-line">
          <div class="flex justify-between py-2"><dt>Construction</dt><dd>$58,000</dd></div>
          <div class="flex justify-between py-2"><dt>Permits & design</dt><dd>$6,400</dd></div>
          <div class="flex justify-between bg-clay-tint px-2 py-2 text-clay-dk"><dt>Contingency 12%</dt><dd>$7,700</dd></div>
          <div class="flex justify-between py-2 font-semibold"><dt>Total</dt><dd>$72,100</dd></div>
        </dl>
      </div>
    </div>
  </Section>

  <Section id="draws" num="05" tab="Payment" title="How we get paid" note="The actual draw schedule. Publishing it pre-empts the most uncomfortable conversation in the sales process.">
    <div class="chamfer border border-line bg-white px-5 md:px-7">
      <table class="tbl tbl-stack">
        <caption class="sr-only">Draw schedule</caption>
        <thead><tr><th scope="col">Milestone</th><th scope="col">Share</th><th scope="col">When it is due</th></tr></thead>
        <tbody>{draws.map((d) => <tr><td data-label="Milestone" class="font-display text-[18px] font-medium">{d.stage}</td><td data-label="Share" class="font-mono">{d.pct}</td><td data-label="When" class="text-slate">{d.when}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="mt-4 max-w-[70ch] text-[15px] leading-relaxed">BC's <em>Builders Lien Act</em> requires the owner to hold back <span class="font-mono">10%</span> of every payment for <span class="font-mono">33 days</span> after completion. We build the holdback into the schedule rather than asking you to manage it, and provide statutory declarations from every trade before it is released.</p>
  </Section>

  <section class="bg-clay-tint py-14 md:py-16" aria-labelledby="est-title">
    <div class="container-x flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="eyebrow">06 / Your range</p>
        <h2 id="est-title" class="h2 mt-2">Get a range for your own house.</h2>
        <p class="mt-2 text-[16px] text-slate">Five questions, two minutes. The range shows before we ask for anything.</p>
      </div>
      <a href="/pricing/estimator/" class="btn-secondary shrink-0 whitespace-nowrap bg-white">Get a budget range</a>
    </div>
  </section>

  <Section id="finals" num="07" tab="Finals" title="Three real final numbers" tone="dark" note="Signed against final, planned against actual. One of the three went over. The overrun is shown.">
    <div class="grid gap-4 lg:grid-cols-3">
      {finals.map((p) => {
        const over = p.final! > p.signed;
        return (
          <article class="chamfer chamfer-dark border border-slate bg-char-lt p-6">
            <p class="text-[13px] text-mist">{p.municipality} · {p.scope}</p>
            <h3 class="mt-2 font-display text-[22px] font-medium leading-tight text-plaster"><a href={`/projects/${p.slug}/`} class="hover:underline hover:underline-offset-4">{p.title}</a></h3>
            <dl class="mt-5 grid grid-cols-2 gap-4 font-mono text-[15px] text-plaster">
              <div><dt class="font-sans text-[12px] text-mist">Signed</dt><dd class="mt-1">{money(p.signed)}</dd></div>
              <div><dt class="font-sans text-[12px] text-mist">Final</dt><dd class:list={["mt-1", over && "text-clay-br"]}>{money(p.final!)}</dd></div>
              <div><dt class="font-sans text-[12px] text-mist">Change orders</dt><dd class="mt-1">{p.changeOrders.length}</dd></div>
              <div><dt class="font-sans text-[12px] text-mist">Weeks</dt><dd class:list={["mt-1", p.weeksActual! > p.weeksPlanned && "text-clay-br"]}>{p.weeksActual} / {p.weeksPlanned}</dd></div>
            </dl>
            <p class="mt-5">{over ? <StatusMark tone="dark" status="behind" label={`Over by ${money(p.final! - p.signed)}`} /> : <StatusMark tone="dark" status="on-schedule" label={p.final! < p.signed ? `Under by ${money(p.signed - p.final!)}` : "On budget"} />}</p>
          </article>
        );
      })}
    </div>
  </Section>

  <Section id="not-for" num="08" tab="Not for" title="Who we are not for">
    <ul class="grid gap-px border border-line bg-line md:grid-cols-2">
      {notFor.map((n) => <li class="bg-white p-6 font-display text-[20px] font-medium leading-snug md:text-[22px]">{n}</li>)}
    </ul>
  </Section>

  <CTABand />
</Base>
