---
export interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="border-b border-line bg-plaster">
  <ol class="container-x flex flex-wrap items-center gap-x-2 gap-y-1 py-3 text-[13px] text-slate">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href && i < items.length - 1 ? (
          <a href={c.href} class="inline-flex min-h-[24px] items-center underline-offset-4 hover:text-char hover:underline">{c.label}</a>
        ) : (
          <span aria-current="page" class="text-char">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
