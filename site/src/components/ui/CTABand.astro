---
import { phone } from "../../data/site";
interface Props {
  title?: string;
  text?: string;
  secondary?: { label: string; href: string } | null;
}
const {
  title = "Start with a site visit.",
  text = "60–90 minutes at your house, usually within two to three weeks. You leave with a fixed scope and price in five to ten business days, whether you hire us or not.",
  secondary = { label: "Get a budget range", href: "/pricing/estimator/" },
} = Astro.props;
const src = Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
---
<section aria-label="Book a site visit" class="bg-char py-14 text-plaster md:py-20">
  <div class="container-x grid gap-8 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <h2 class="font-display text-[32px] font-semibold leading-[1.05] md:text-[48px]">{title}</h2>
      <p class="mt-4 max-w-[54ch] text-[17px] leading-relaxed text-mist">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
      <a href={`/book/?src=${src}&pos=footer`} class="btn-primary">Book a site visit</a>
      {secondary && (
        <a href={secondary.href} class="inline-flex h-12 items-center justify-center rounded-[2px] border border-plaster px-6 text-[16px] font-medium text-plaster transition-colors duration-150 hover:bg-plaster hover:text-char">{secondary.label}</a>
      )}
    </div>
    <p class="text-[15px] text-mist lg:col-span-12">Or call <a href={phone.href} class="font-mono text-plaster underline underline-offset-4">{phone.display}</a>, weekdays <span class="font-mono">07:30–17:00</span>.</p>
  </div>
</section>
