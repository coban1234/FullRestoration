---
/** Placeholder for a real site photograph (spec §12: documentary, no stock, no AI). Replace with <img> once shot. */
interface Props { label: string; caption?: string; ratio?: string; class?: string }
const { label, caption, ratio = "aspect-[3/2]", class: cls = "" } = Astro.props;
---
<figure class:list={["border border-line bg-white p-2.5", cls]}>
  <div role="img" aria-label={`Photograph to come: ${label}`} class:list={["photo-slot flex items-center justify-center p-6 text-center", ratio]}>
    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-slate">Photo slot<br /><span class="mt-1 inline-block normal-case tracking-normal text-char">{label}</span></span>
  </div>
  {caption && <figcaption class="px-0.5 pb-0.5 pt-2.5 font-mono text-[11px] leading-snug text-slate">{caption}</figcaption>}
</figure>
